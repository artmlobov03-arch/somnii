# Скопируй этот файл в .env и вставь свой ключ локально.
OPENAI_API_KEY=sk-proj-your-key-here
# Модель можно изменить при необходимости.
OPENAI_MODEL=gpt-5
PORT=3000
# Локально используется SQLite. На Render обязательно укажи Internal Database URL.
# DATABASE_URL=postgresql://user:password@host/database
# Необязательный путь к локальной базе (по умолчанию data/somnii.sqlite).
# SQLITE_PATH=data/somnii.sqlite
